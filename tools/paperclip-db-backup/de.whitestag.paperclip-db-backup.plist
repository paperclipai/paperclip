<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.whitestag.paperclip-db-backup</string>

    <!-- Einstieg ueber node, NICHT ueber bash: ein launchd-Job aus zsh/bash
         darf nicht auf die SMB-Freigabe zugreifen (TCC, "Operation not
         permitted"). node hat die Berechtigung und vererbt sie. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/walterschoenenbroecher.de/.paperclip/scripts/paperclip-db-backup/run-backup.js</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/walterschoenenbroecher.de/.paperclip/logs/paperclip-db-backup.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/walterschoenenbroecher.de/.paperclip/logs/paperclip-db-backup.launchd.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
