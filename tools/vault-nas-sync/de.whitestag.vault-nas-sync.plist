<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.whitestag.vault-nas-sync</string>

    <!-- Einstieg ueber node, NICHT bash: sonst scheitert der Zugriff auf die
         SMB-Freigabe still an TCC. -->
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/walterschoenenbroecher.de/.paperclip/scripts/vault-nas-sync/run-vault-nas-sync.js</string>
    </array>

    <!-- 04:00: nach der DB-Sicherung (02:30) und dem Vault-Backup nach
         Hetzner (sonntags 03:30), vor der Nextcloud-Sicherung (05:00). -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>4</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/walterschoenenbroecher.de/.paperclip/logs/vault-nas-sync.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/walterschoenenbroecher.de/.paperclip/logs/vault-nas-sync.launchd.log</string>

    <key>RunAtLoad</key><false/>
</dict>
</plist>
