{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paperclip planned chat scenarios for one feature area",
  "description": "Applies to area YAML files, excluding defaults.yaml. Structural validity does not establish runnable or passing coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "feature", "status", "scenarios"],
  "properties": {
    "schema_version": { "const": 1 },
    "feature": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "const": "planned" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "capabilities", "context", "query", "expected_outcome"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$" },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9-]+/[a-z0-9-]+$" }
          },
          "context": { "type": "string", "pattern": "\\S" },
          "query": { "type": "string", "pattern": "\\S" },
          "expected_outcome": { "type": "string", "pattern": "\\S" }
        }
      }
    }
  }
}
