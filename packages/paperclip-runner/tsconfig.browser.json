{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": ".",
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@paperclipai/paperclip-runner/browser": ["src/browser/index.ts"],
      "@paperclipai/paperclip-runner/react": ["src/react/index.ts"],
      "@paperclipai/paperclip-runner/styles.css": ["styles.css"]
    }
  },
  "include": [
    "devtools/browser/src/**/*.ts",
    "devtools/browser/src/**/*.tsx",
    "examples/*/src/**/*.ts",
    "examples/*/src/**/*.tsx"
  ]
}
