{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paperclip.dev/schemas/prp/v1/auth-credentials.schema.json",
  "title": "PRP credential update notification",
  "description": "Content-free evidence of changed credentials for the harness-auth binding in this normalized session. Credential-store detection does not prove an OAuth refresh succeeded.",
  "type": "object",
  "required": [
    "schema",
    "provider",
    "bindingId",
    "revision",
    "detection"
  ],
  "properties": {
    "schema": {
      "const": "paperclip.auth.credentials.updated.v1"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "bindingId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "detection": {
      "enum": [
        "credential_store",
        "native_hook"
      ]
    }
  },
  "additionalProperties": false
}
