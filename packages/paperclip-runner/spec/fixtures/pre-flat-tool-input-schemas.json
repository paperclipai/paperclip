       "type": "string"
      }
     },
     "required": [
      "toAgentId",
      "phase",
      "instructions"
     ],
     "type": "object"
    },
    "projectId": {
     "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
     "type": [
      "string",
      "null"
     ]
    },
    "summary": {
     "maxLength": 8000,
     "type": "string"
    },
    "title": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "workflowId": {
     "description": "Adopt this company workflow’s latest prompt.",
     "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
     "type": "string"
    },
    "workflow_document_text": {
     "description": "Workflow instructions as nonblank text. Recommend Markdown with both a fenced Mermaid stateDiagram-v2 diagram and prose for each transition. Use stable state IDs matching phase names; define each named arrow outcome in prose with its trigger or condition, required evidence or outputs, destination agent ID, human wait and resume behavior, and bounded correction, retry or escalation rules. The diagram is advisory. Required for a new case or its first workflow task unless workflowId is supplied; omit on later handoffs. Stored unchanged as the ordinary task document key workflow, title Workflow. The server does not parse the flow or enforce transitions. Combined workflow text and normalized initial document bodies must total at most 200000 characters.",
     "maxLength": 200000,
     "minLength": 1,
     "pattern": "\\S",
     "type": "string"
    }
   },
   "required": [
    "idempotencyKey",
    "caseType",
    "title",
    "kickoff"
   ],
   "type": "object"
  },
  "read_workflow": {
   "additionalProperties": false,
   "allOf": [
    {
     "if": {
      "properties": {
       "responseText": {
        "properties": {
         "offsetBytes": {
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "offsetBytes"
        ],
        "type": "object"
       }
      },
      "required": [
       "responseText"
      ]
     },
     "then": {
      "properties": {
       "snapshot": {}
      },
      "required": [
       "snapshot"
      ]
     }
    }
   ],
   "properties": {
    "responseText": {
     "additionalProperties": false,
     "properties": {
      "limitBytes": {
       "maximum": 24576,
       "minimum": 4,
       "type": "integer"
      },
      "offsetBytes": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "snapshot": {
     "description": "Content fingerprint returned by the first page; required for continuation pages.",
     "pattern": "^[a-f0-9]{64}$",
     "type": "string"
    },
    "workflowId": {
     "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
     "type": "string"
    }
   },
   "required": [
    "workflowId"
   ],
   "type": "object"
  },
  "update_workflow": {
   "additionalProperties": false,
   "anyOf": [
    {
     "properties": {
      "name": {}
     },
     "required": [
      "name"
     ]
    },
    {
     "properties": {
      "prompt": {}
     },
     "required": [
      "prompt"
     ]
    }
   ],
   "properties": {
    "idempotencyKey": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "name": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "prompt": {
     "description": "Reusable Markdown instructions for LLM execution. Phases and routing are advisory instructions, not a state machine.",
     "maxLength": 200000,
     "minLength": 1,
     "pattern": "\\S",
     "type": "string"
    },
    "workflowId": {
     "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
     "type": "string"
    }
   },
   "required": [
    "workflowId",
    "idempotencyKey"
   ],
   "type": "object"
  },
  "paperclip_finish": {
   "type": "object",
   "additionalProperties": true,
   "required": [
    "reportedWorkDisposition",
    "summary",
    "completionClaim",
    "evidence",
    "verification"
   ],
   "properties": {
    "schema": {
     "enum": [
      "paperclip.run_result.v1",
      "paperclip_finish",
      "paperclip_paperclip_finish",
      "paperclip_finish.v1"
     ]
    },
    "summary": {
     "type": "string",
     "minLength": 1,
     "description": "The complete user-facing answer for this turn. Do not replace the requested answer with routine work/control bookkeeping. Include the requested result and any genuine actionable failure, limitation, or required user action. Unless explicitly requested, omit routine preparation, unconfirmed-delivery, and wait/review status; put the response-wake reason in continuation.summary. Never claim delivery without a confirmed receipt."
    },
    "completionClaim": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "contractRevision",
      "objectiveSatisfied",
      "criteria",
      "remainingWork"
     ],
     "properties": {
      "contractRevision": {
       "type": "string",
       "minLength": 1,
       "description": "Use the current turn completion.revision (or completionContract.revision on the first turn), never a previous turn’s revision. On stale-revision feedback, reassess the current request and correct the report without repeating completed work."
      },
      "objectiveSatisfied": {
       "type": "boolean"
      },
      "criteria": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "criterionId",
         "status",
         "evidenceRefs"
        ],
        "properties": {
         "criterionId": {
          "type": "string",
          "minLength": 1
         },
         "status": {
          "enum": [
           "satisfied",
           "not_satisfied",
           "unknown",
           "pass",
           "passed",
           "complete",
           "completed",
           "fail",
           "failed",
           "incomplete"
          ],
          "description": "Use satisfied when the criterion is met, not_satisfied when it is not met, or unknown when no verdict is available. Common provider aliases are accepted and normalized."
         },
         "evidenceRefs": {
          "type": "array",
          "items": {
           "type": "string"
          }
         }
        }
       }
      },
      "remainingWork": {
       "type": "array",
       "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "description",
         "blocksCompletion"
        ],
        "properties": {
         "description": {
          "type": "string",
          "minLength": 1
         },
         "blocksCompletion": {
          "type": "boolean"
         }
        }
       }
      }
     }
    },
    "evidence": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "ref"
      ],
      "properties": {
       "ref": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "verification": {
     "type": "array",
     "description": "Checks used to verify the work. Use failed only when the check actually ran and found a defect in the work. If a check could not run or complete because the environment, tool, dependency, permission, credential, policy, external service, or budget was unavailable, use not_run with reasonCode even when the attempted command exited non-zero.",
     "items": {
      "type": "object",
      "additionalProperties": true,
      "required": [
       "status"
      ],
      "properties": {
       "commandOrCheck": {
        "type": "string",
        "minLength": 1
       },
       "command": {
        "type": "string",
        "minLength": 1
       },
       "status": {
        "enum": [
         "passed",
         "failed",
         "not_run",
         "blocked",
         "skipped",
         "pass",
         "success",
         "succeeded",
         "fail"
        ],
        "description": "passed: the check ran and succeeded. failed: the check ran to a meaningful verdict and found the work incorrect. not_run: no meaningful verdict because the check was not attempted or could not complete. Prefer not_run over legacy blocked/skipped, and include reasonCode for any unavailable check."
       },
       "reasonCode": {
        "enum": [
         "environment_unavailable",
         "tool_unavailable",
         "dependency_missing",
         "permission_denied",
         "credential_missing",
         "policy_restricted",
         "external_service_unavailable",
         "budget_exhausted",
         "other"
        ],
        "description": "Required for not_run; identify why the check had no meaningful verdict."
       },
       "detail": {
        "type": "string"
       },
       "result": {
        "type": "string"
       },
       "cwd": {
        "type": "string"
       },
       "artifactRef": {
        "type": [
         "string",
         "null"
        ],
        "description": "Reference to a real verification artifact. Omit or use null when no artifact exists; empty values are normalized away."
       }
      }
     }
    },
    "attentionRequests": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": true,
      "required": [
       "kind",
       "summary"
      ],
      "properties": {
       "kind": {
        "type": "string",
        "minLength": 1
       },
       "summary": {
        "type": "string",
        "minLength": 1
       },
       "ownerClass": {
        "enum": [
         "human",
         "agent",
         "external_system"
        ]
       },
       "targetAgentId": {
        "type": "string",
        "minLength": 1
       },
       "requestedCapability": {
        "type": "string",
        "minLength": 1
       },
       "requiredAuthority": {
        "type": "string",
        "minLength": 1
       },
       "target": {
        "type": "object",
        "additionalProperties": true
       }
      }
     }
    },
    "artifacts": {
     "type": "array",
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "kind",
       "ref"
      ],
      "properties": {
       "kind": {
        "type": "string",
        "minLength": 1
       },
       "ref": {
        "type": "string",
        "minLength": 1
       }
      }
     }
    },
    "reportedWorkDisposition": {
     "enum": [
      "done",
      "needs_review",
      "yielded",
      "completed"
     ]
    },
    "continuation": {
     "type": [
      "object",
      "null"
     ],
     "description": "For yielded, omit or use null to reuse this run's authorized published-review wait, eligible saved monitor, or repository-preparation continuation; the controller reads current task state. Otherwise provide a real response_wake or monitor with summary and idempotencyKey. Use null or omit for done, completed, or needs_review.",
     "additionalProperties": false,
     "required": [
      "kind",
      "summary",
      "idempotencyKey"
     ],
     "properties": {
      "kind": {
       "type": "string",
       "enum": [
        "response_wake",
        "monitor",
        "case_handoff"
       ]
      },
      "summary": {
       "type": "string",
       "minLength": 1,
       "description": "Internal control-plane reason to wait for the next response. Keep routine waiting and continuation bookkeeping here, not in the top-level user-facing summary. This field is not the answer to the user's request."
      },
      "idempotencyKey": {
       "type": "string",
       "minLength": 1
      },
      "handoffId": {
       "type": "string",
       "minLength": 1,
       "description": "Exact server-issued handoff ID; required for case_handoff."
      }
     },
     "allOf": [
      {
       "if": {
        "properties": {
         "kind": {
          "const": "case_handoff"
         }
        },
        "required": [
         "kind"
        ]
       },
       "then": {
        "required": [
         "handoffId"
        ]
       }
      }
     ]
    }
   },
   "if": {
    "properties": {
     "reportedWorkDisposition": {
      "const": "yielded"
     }
    },
    "required": [
     "reportedWorkDisposition"
    ]
   },
   "then": {
    "properties": {
     "continuation": {
      "type": [
       "object",
       "null"
      ]
     }
    }
   },
   "else": {
    "properties": {
     "continuation": {
      "type": "null"
     }
    }
   }
  }
 }
}
