          "type": "object"
         }
        },
        "required": [
         "case"
        ]
       },
       "then": {
        "oneOf": [
         {
          "properties": {
           "workflowId": {
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
            "type": "string"
           }
          },
          "required": [
           "workflowId"
