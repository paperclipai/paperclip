       "type": "string"
      },
      "case": {
       "oneOf": [
        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
           "type": "string"
          }
         },
         "required": [
          "id"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "create": {
           "additionalProperties": false,
           "properties": {
            "caseType": {
             "maxLength": 120,
             "minLength": 1,
             "type": "string"
            },
            "fields": {
             "additionalProperties": true,
             "type": "object"
            },
            "projectId": {
             "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
             "type": [
              "string",
              "null"
             ]
