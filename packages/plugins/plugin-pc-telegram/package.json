{
  "name": "@andhash/plugin-pc-telegram",
  "version": "0.1.0",
  "description": "Paperclip plugin for personal Telegram accounts via MTProto QR login",
  "license": "MIT",
  "homepage": "https://github.com/andhash/paperclip",
  "bugs": {
    "url": "https://github.com/andhash/paperclip/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/andhash/paperclip",
    "directory": "packages/plugins/plugin-pc-telegram"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "telegram",
    "mtproto",
    "connector"
  ],
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "tsc && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "prepack": "rm -f package.dev.json && cp package.json package.dev.json && node ../../../scripts/generate-plugin-package-json.mjs",
    "postpack": "if [ -f package.dev.json ]; then mv package.dev.json package.json; fi"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*",
    "telegram": "^2.26.22",
    "uqr": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=24.11.0"
  }
}
