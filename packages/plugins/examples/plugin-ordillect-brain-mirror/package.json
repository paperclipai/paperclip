{
  "name": "@paperclipai/plugin-ordillect-brain-mirror",
  "version": "0.1.0",
  "description": "Mirrors Paperclip issue-thread comments into per-issue Honcho sessions in the ordillect-brain workspace (AGE-101).",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
