+/** Live promises never become authority to replay an answer after provider death. */
+export class PiUiBridge {
+                   pending = new Map                            ();
+                   seen = new Set        ();
+                   sessionId        ;
+                   connection              ;
+                   process           ;
+  constructor(sessionId        , connection              , process           ) { this.sessionId = sessionId; this.connection = connection; this.process = process; }
