+async function resolveOwnerDecisionActorUserId(
+  ctx: PluginContext,
+  boardAccess: TelegramBoardAccessState,
+  companyId: string,
+  baseUrl: string,
+  boardApiToken?: string,
+): Promise<{ ok: true; actorUserId: string } | { ok: false; message: string }> {
+  if (boardAccess.companyId && boardAccess.companyId !== companyId) {
+    return { ok: false, message: "Board access company mismatch" };
+  }
+
+  if (boardAccess.actorUserId) {
+    return { ok: true, actorUserId: boardAccess.actorUserId };
+  }
+
+  if (!boardApiToken) {
+    return { ok: false, message: "Connect board access in Paperclip Telegram settings" };
+  }
+
+  try {
+    const response = await fetchPaperclipApi(ctx, `${baseUrl}/api/cli-auth/me`, {
+      headers: {
+        ...buildPaperclipAuthHeaders(boardApiToken),
+      },
+    });
+    const me = await response.json() as { userId?: unknown; user?: { id?: unknown } | null };
+    const actorUserId =
+      asNonEmptyString(me.userId)
+      ?? asNonEmptyString(me.user?.id);
+    if (!actorUserId) {
+      return { ok: false, message: "Connect board access in Paperclip Telegram settings" };
+    }
+
+    // Persist the canonical ID so legacy board-access state recovers without reconnect.
+    await persistBoardAccessState(ctx, {
+      ...boardAccess,
+      actorUserId,
+      updatedAt: new Date().toISOString(),
+    });
+    return { ok: true, actorUserId };
+  } catch {
+    return { ok: false, message: "Connect board access in Paperclip Telegram settings" };
+  }
+}
