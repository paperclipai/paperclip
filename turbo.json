{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "*",
    "**/package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".npmrc",
    "tsconfig*.json",
    "vitest.config.ts",
    "**/vitest.config.*",
    "**/vite.config.*",
    "**/vitest.setup.*",
    "**/tsconfig*.json",
    "scripts/**",
    ".github/**",
    "patches/**",
    "tests/fixtures/**",
    "tests/helpers/**",
    "tests/runner-e2e/fixtures/**",
    "tests/tsconfig.playwright.json",
    "tests/acpx-qualification-models.ts",
    "doc/**",
    "docs/**",
    "skills/**",
    ".agents/**",
    "maps/**",
    ".claude/**"
  ],
  "globalEnv": [
    "CI",
    "CI_TASK_CACHE_SCOPE",
    "GITHUB_WORKFLOW",
    "NODE_OPTIONS",
    "TZ",
    "PAPERCLIP_*",
    "TEST_*",
    "VITE_*",
    "DATABASE_URL",
    "PG*",
    "RUST*",
    "CARGO*",
    "NODE_ENV",
    "XDG_*",
    "LANG",
    "LC_*",
    "GIT_*",
    "NPM_CONFIG_*",
    "npm_config_*"
  ],
  "globalPassThroughEnv": [
    "GITHUB_*",
    "RUNNER_*",
    "SSH_AUTH_SOCK",
    "TMPDIR",
    "TMP",
    "TEMP",
    "HOME",
    "USER",
    "SHELL"
  ],
  "tasks": {
    "//#ci:server": {
      "inputs": [
        "server/**",
        "cli/**",
        "packages/**",
        "ui/src/lib/**",
        "ui/src/api/**",
        "ui/src/types/**",
        "ui/src/index.css",
        "ui/src/bootstrapSetup.ts",
        "ui/src/pages/CompanyExport.tsx",
        "ui/*",
        "ui/src/components/MarkdownBody.tsx"
      ],
      "outputs": [],
      "cache": true
    },
    "//#ci:chat": {
      "inputs": [
        "server/**",
        "cli/**",
        "packages/**",
        "ui/src/lib/**",
        "ui/src/api/**",
        "ui/src/types/**",
        "ui/src/index.css",
        "ui/src/bootstrapSetup.ts",
        "ui/src/pages/CompanyExport.tsx",
        "ui/*",
        "ui/src/components/MarkdownBody.tsx"
      ],
      "outputs": [],
      "cache": true
    },
    "//#ci:workspaces-a": {
      "inputs": [
        "ui/**",
        "cli/**",
        "packages/db/**",
        "packages/shared/**",
        "packages/adapter-utils/**",
        "packages/adapters/**",
        "packages/paperclip-runner/**",
        "packages/plugins/**",
        "server/src/services/agent-conversations.ts",
        "announcements/examples/animated/**"
      ],
      "outputs": [],
      "cache": true
    },
    "//#ci:workspaces-b": {
      "inputs": [
        "server/**",
        "cli/**",
        "packages/**",
        "ui/src/lib/**",
        "ui/public/**"
      ],
      "outputs": [],
      "cache": true
    },
    "//#ci:db": {
      "inputs": [
        "packages/db/**",
        "packages/shared/**"
      ],
      "outputs": [],
      "cache": true
    },
    "//#ci:serialized": {
      "inputs": [
        "server/**",
        "cli/**",
        "packages/**",
        "ui/src/lib/**",
        "ui/src/api/**",
        "ui/src/types/**",
        "ui/src/index.css",
        "ui/src/bootstrapSetup.ts",
        "ui/src/pages/CompanyExport.tsx",
        "ui/*",
        "ui/src/components/MarkdownBody.tsx"
      ],
      "outputs": [],
      "cache": true
    },
    "//#ci:runner-static": {
      "inputs": [
        "server/**",
        "packages/**",
        "tests/runner-e2e/**",
        "ui/src/lib/**",
        "ui/src/api/**",
        "ui/src/types/**",
        "ui/src/index.css",
        "ui/src/bootstrapSetup.ts",
        "ui/src/pages/CompanyExport.tsx",
        "ui/*",
        "ui/src/components/MarkdownBody.tsx"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:runner-rust": {
      "inputs": [
        "packages/paperclip-runner/**"
      ],
      "outputs": [],
      "cache": true
    },
    "//#ci:runner-package": {
      "inputs": [
        "packages/paperclip-runner/**",
        "packages/paperclip-eval-kernel/**",
        "packages/adapters/codex-local/**",
        "packages/adapter-utils/**",
        "tests/runner-e2e/**"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:runner-vitest": {
      "inputs": [
        "server/**",
        "packages/**",
        "ui/src/lib/**",
        "ui/src/api/**",
        "ui/src/types/**",
        "ui/src/index.css",
        "ui/src/bootstrapSetup.ts",
        "ui/src/pages/CompanyExport.tsx",
        "ui/*",
        "ui/src/components/MarkdownBody.tsx"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:typecheck": {
      "inputs": [
        "server/**",
        "cli/**",
        "packages/**",
        "ui/**",
        "tests/e2e/**",
        "tests/runner-e2e/**"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:build": {
      "inputs": [
        "server/**",
        "cli/**",
        "packages/**",
        "ui/**"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:sandbox-providers": {
      "inputs": [
        "packages/plugins/sandbox-providers/**",
        "packages/plugins/sdk/**",
        "packages/shared/**"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:docker": {
      "inputs": [
        "packages/paperclip-runner/**"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:canary": {
      "inputs": [
        "scripts/**",
        "cli/esbuild.config.mjs",
        "server/scripts/**",
        "packages/paperclip-runner/scripts/**",
        "packages/paperclip-runner/release-runner-targets.json"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:e2e": {
      "inputs": [
        "server/**",
        "cli/**",
        "packages/**",
        "ui/**",
        "tests/e2e/**"
      ],
      "outputs": [],
      "cache": false
    },
    "//#ci:runner-e2e-support": {
      "inputs": [
        "tests/runner-e2e/**",
        "packages/paperclip-runner/**",
        "packages/plugins/sdk/**",
        "packages/adapter-utils/**",
        "packages/adapters/**",
        "server/src/services/native-runtime/**",
        "server/src/vendor/paperclip-runner/**",
        "server/src/routes/native-run-mcp.ts",
        "server/src/adapters/**",
        "ui/src/lib/company-routes.ts",
        "ui/src/lib/company-skill-routes.ts",
        "ui/src/lib/grok-bot-setup-prompt.ts",
        "ui/src/lib/issue-reference.ts",
        "ui/src/lib/markdown-reply-content.ts",
        "ui/src/lib/onboarding-route.ts"
      ],
      "outputs": [],
      "cache": false
    }
  }
}
