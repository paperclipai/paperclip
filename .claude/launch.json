{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "paperclip",
      "port": 3121,
      "url": "http://localhost:3121"
    },
    {
      "name": "storybook",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "PAPERCLIP_STORYBOOK_API_URL=http://localhost:3121 pnpm --filter @paperclipai/ui exec storybook dev -p 6016 -c storybook/.storybook --no-open --ci"
      ],
      "port": 6016
    },
    {
      "name": "cloud-web",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd /Users/tonio/Projects/paperclip-cloud/.worktrees/deploy-stack-master/web && npx vite --port 4173 --strictPort"
      ],
      "port": 4173
    },
    {
      "name": "artifact-directions-dev",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd ui && npx vite --config vite.artifact-directions.config.mjs --port 5180 --strictPort"
      ],
      "port": 5180
    },
    {
      "name": "artifact-directions",
      "runtimeExecutable": "/bin/sh",
      "runtimeArgs": [
        "-c",
        "cd ui && export ARTIFACT_DIRECTIONS_OUT_DIR=node_modules/.artifact-directions-dist && npx vite build --config vite.artifact-directions.config.mjs && npx vite preview --config vite.artifact-directions.config.mjs --port 5190 --strictPort"
      ],
      "port": 5190
    }
  ]
}
