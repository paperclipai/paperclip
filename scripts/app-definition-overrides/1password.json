{
  "schemaVersion": 1,
  "slug": "1password",
  "name": "1Password",
  "description": "Read and manage items and secrets in the vaults you authorize.",
  "categories": [
    "developer"
  ],
  "branding": {
    "logoUrl": "/brands/apps/1password.svg",
    "darkLogoUrl": "/brands/apps/1password-dark.svg"
  },
  "urlPatterns": [
    "https://*.1password.com/*",
    "https://*.1password.ca/*",
    "https://*.1password.eu/*"
  ],
  "docsUrl": "https://www.1password.dev/service-accounts/get-started",
  "methods": [
    {
      "key": "service-account",
      "label": "Connect 1Password",
      "transport": "rest_api",
      "auth": "api_key",
      "ownershipModes": [
        "customer"
      ],
      "whenToUse": "Use a service account scoped to the vaults your agents need.",
      "defaults": {
        "serverUrl": "https://my.1password.com/"
      },
      "credentialFields": [
        {
          "key": "authorization",
          "label": "Paste your 1Password Service Account token",
          "type": "password",
          "required": true,
          "secret": true,
          "placeholder": "ops_…"
        }
      ],
      "keyPlacement": {
        "location": "header",
        "name": "Authorization",
        "prefix": "Bearer "
      },
      "guidanceMd": "[Create a 1Password service account](https://www.1password.dev/service-accounts/get-started#create-a-service-account), choose its vaults and permissions, then paste its token below.",
      "consoleLinks": {
        "docs": "https://www.1password.dev/service-accounts/get-started#create-a-service-account"
      },
      "warnings": [
        "Authorized agents can read secret values and change or delete items in the selected vaults. Grant access only to trusted agents."
      ],
      "riskTier": "S4",
      "requiredResourceFilters": [
        "vault"
      ]
    }
  ]
}
