#!/usr/bin/env bash
# TON-814 - refuse a merge that would delete the productivity-review service.
#
# Upstream (paperclipai/paperclip) removed the productivity-review feature in
# 3bafac12f, and the long_active_duration false-positive fix (fa3c22dd) only
# exists on our fork branch fork/ton/deployed-long-active-fix. Merging upstream
# master into the deployed tree would delete:
#   server/src/services/productivity-review.ts
#   server/src/__tests__/productivity-review-service.test.ts
# in one move - the platform would lose every legitimate review too.
#
# This hook runs after the merge result is in the index and BEFORE the commit
# is created, so aborting here leaves the merge un-committed and reversible.

set -uo pipefail

SERVICE="server/src/services/productivity-review.ts"
TESTFILE="server/src/__tests__/productivity-review-service.test.ts"
MARKER="findLiveContinuationPath"

for path in "$SERVICE" "$TESTFILE"; do
  if ! git cat-file -e ":$path" 2>/dev/null; then
    echo "pre-merge-commit: REFUSING the merge." >&2
    echo "  $path would be deleted by this merge." >&2
    echo "  Upstream (paperclipai/paperclip) removed the productivity-review feature" >&2
    echo "  in 3bafac12f; the long_active_duration fix (fa3c22dd) exists only on" >&2
    echo "  fork/ton/deployed-long-active-fix." >&2
    echo "  Undo with 'git merge --abort', then deploy from the durable branch:" >&2
    echo "    git fetch fork && git checkout fork/ton/deployed-long-active-fix" >&2
    exit 1
  fi
done

# The file can survive while the fix inside it is reverted.
#
# Capture the blob FIRST, then match. A `git show | grep -q` pipeline is
# WRONG here: `grep -q` exits on the first match, `git show` is killed by
# SIGPIPE (141), and `pipefail` turns that into a failed pipeline - which
# reads as "the marker is missing" and refuses the merge spuriously.
service_blob=""
if git cat-file -e ":$SERVICE" 2>/dev/null; then
  service_blob="$(git show ":$SERVICE" 2>/dev/null || true)"
  if [[ "$service_blob" != *"$MARKER"* ]]; then
    echo "pre-merge-commit: REFUSING the merge." >&2
    echo "  $SERVICE would lose the $MARKER fix in this merge." >&2
    echo "  Undo with 'git merge --abort'." >&2
    exit 1
  fi
fi

exit 0
