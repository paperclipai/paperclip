#!/opt/camoufox/bin/python
import argparse
import json
import os
import re
import urllib.request
from pathlib import Path

from camoufox.sync_api import Camoufox


def safe(value: str) -> str:
    return re.sub(r"[^a-zA-Z0-9._-]", "_", value)[:120] or "default"


parser = argparse.ArgumentParser(description="Open a URL with Paperclip's managed Camoufox fallback")
parser.add_argument("url")
parser.add_argument("--screenshot")
args = parser.parse_args()

api_url = os.environ.get("PAPERCLIP_API_URL", "").rstrip("/")
api_key = os.environ.get("PAPERCLIP_API_KEY", "")
run_id = os.environ.get("PAPERCLIP_RUN_ID", "")
if api_url and api_key and run_id:
    try:
        request = urllib.request.Request(
            f"{api_url}/api/heartbeat-runs/{run_id}/browser-activity",
            data=b"",
            method="POST",
            headers={"Authorization": f"Bearer {api_key}", "X-Paperclip-Run-Id": run_id},
        )
        urllib.request.urlopen(request, timeout=3).close()
    except Exception:
        pass

profile = safe(os.environ.get("AGENT_BROWSER_SESSION_NAME", "paperclip-default"))
scope = safe(os.environ.get("PAPERCLIP_BROWSER_SCOPE_ID", os.environ.get("PAPERCLIP_RUN_ID", "manual")))
root = Path(os.environ.get("PAPERCLIP_HOME", "/paperclip")) / "browser-profiles" / profile
root.mkdir(parents=True, exist_ok=True)
state_path = root / "camoufox-state.json"
artifact_dir = Path(os.environ.get("PAPERCLIP_HOME", "/paperclip")) / "browser-artifacts"
artifact_dir.mkdir(parents=True, exist_ok=True)
screenshot_path = Path(args.screenshot) if args.screenshot else artifact_dir / f"{scope}-camoufox.jpg"
provider_path = artifact_dir / f"{scope}-provider"
provider_path.write_text("camoufox\n")
provider_path.chmod(0o600)

with Camoufox(headless="virtual", humanize=True, persistent_context=False) as browser:
    context_options = {"storage_state": str(state_path)} if state_path.exists() else {}
    context = browser.new_context(**context_options)
    page = context.new_page()
    page.goto(args.url, wait_until="domcontentloaded", timeout=45_000)
    temporary_screenshot = screenshot_path.with_suffix(".tmp.jpg")
    page.screenshot(path=str(temporary_screenshot), type="jpeg", quality=78, full_page=False)
    temporary_screenshot.replace(screenshot_path)
    screenshot_path.chmod(0o600)
    temporary_state = state_path.with_suffix(".tmp")
    context.storage_state(path=str(temporary_state))
    temporary_state.replace(state_path)
    state_path.chmod(0o600)
    print(json.dumps({
        "provider": "camoufox",
        "mode": "virtual-headful",
        "url": page.url,
        "title": page.title(),
        "screenshot": str(screenshot_path),
        "profile": profile,
        "scope": scope,
        "sessionState": "independent",
    }))
