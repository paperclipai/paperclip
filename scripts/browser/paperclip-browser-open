#!/bin/sh
set -eu

if [ "$#" -lt 1 ]; then
  echo "usage: paperclip-browser-open <url> [--camoufox]" >&2
  exit 2
fi

URL="$1"

case "${2:-}" in
  ""|--camoufox) ;;
  *)
    echo "[paperclip-browser] unsupported provider option '${2:-}'; Camoufox is the only enabled managed provider" >&2
    exit 64
    ;;
esac

if [ "${PAPERCLIP_BROWSER_PROVIDER:-}" = "agent-browser" ]; then
  echo "[paperclip-browser] ignoring PAPERCLIP_BROWSER_PROVIDER=agent-browser; agent-browser is disabled" >&2
fi

echo "[paperclip-browser] using provider=camoufox (agent-browser disabled)" >&2
exec paperclip-camoufox "$URL"
