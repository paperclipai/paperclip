#!/bin/sh
set -u

REAL_AGENT_BROWSER="${PAPERCLIP_AGENT_BROWSER_REAL:-/usr/local/bin/agent-browser-real}"
PROFILE_NAME="${AGENT_BROWSER_SESSION_NAME:-}"
PROFILE_ROOT="${PAPERCLIP_BROWSER_PROFILE_ROOT:-/paperclip/browser-profiles}"
RUNTIME_HOME="${PAPERCLIP_BROWSER_RUNTIME_HOME:-}"

echo "[paperclip-browser] agent-browser is disabled; use paperclip-browser-open or paperclip-camoufox" >&2
exit 69

for argument in "$@"; do
  case "$argument" in
    --session|--session=*|--session-name|--session-name=*|--profile|--profile=*|--state|--state=*|--cdp|--cdp=*|--auto-connect|--provider|--provider=*|-p)
      echo "[paperclip-browser] '$argument' is not allowed in a managed run; Paperclip owns issue sessions and company/project profiles" >&2
      exit 64
      ;;
  esac
done

case "${1:-}" in
  state|profiles)
    echo "[paperclip-browser] '${1:-}' is managed by Paperclip and cannot be invoked directly in an agent run" >&2
    exit 64
    ;;
esac

if [ -n "$RUNTIME_HOME" ]; then
  mkdir -p "$RUNTIME_HOME"
  chmod 700 "$RUNTIME_HOME" 2>/dev/null || true
  export HOME="$RUNTIME_HOME"
fi

# Paperclip owns persistence. Native `--session-name` persistence appends the
# isolated daemon session to its filename and reloads that per-issue snapshot
# on every CLI invocation, which defeats a company/project shared profile.
unset AGENT_BROWSER_SESSION_NAME AGENT_BROWSER_RESTORE

safe_profile="$(printf '%s' "$PROFILE_NAME" | tr -c 'a-zA-Z0-9._-' '_')"
profile_dir="$PROFILE_ROOT/$safe_profile"
state_path="$profile_dir/agent-browser-state.json"
if [ -n "${AGENT_BROWSER_ENCRYPTION_KEY:-}" ]; then
  state_path="$state_path.enc"
fi
lock_dir="$profile_dir/.state-lock"
mkdir -p "$profile_dir"
chmod 700 "$profile_dir" 2>/dev/null || true

# Every command for an issue talks to the same browser daemon. Serialize the
# complete load/action/save cycle so overlapping agent shell calls cannot race
# the daemon, invalidate snapshot refs, or render an unrelated empty page.
issue_identity="${AGENT_BROWSER_SESSION:-${PAPERCLIP_BROWSER_SCOPE_ID:-${PAPERCLIP_RUN_ID:-manual}}}"
safe_issue="$(printf '%s' "$issue_identity" | tr -c 'a-zA-Z0-9._-' '_')"
command_lock_root="${AGENT_BROWSER_SOCKET_DIR:-${RUNTIME_HOME:-/tmp}}/.paperclip-command-locks"
command_lock_dir="$command_lock_root/$safe_issue"
activity_root="${AGENT_BROWSER_SOCKET_DIR:-${RUNTIME_HOME:-/tmp}}/.paperclip-browser-activity"
activity_path="$activity_root/$safe_issue.activity"
mkdir -p "$command_lock_root"
chmod 700 "$command_lock_root" 2>/dev/null || true

command_lock_held=false
acquire_command_lock() {
  command_waited=0
  while ! mkdir "$command_lock_dir" 2>/dev/null; do
    owner_pid="$(cat "$command_lock_dir/pid" 2>/dev/null || printf '0')"
    case "$owner_pid" in
      ''|*[!0-9]*) owner_pid=0 ;;
    esac
    if [ "$owner_pid" -gt 0 ] && ! kill -0 "$owner_pid" 2>/dev/null; then
      rm -rf "$command_lock_dir" 2>/dev/null || true
      continue
    fi
    lock_created="$(stat -c %Y "$command_lock_dir" 2>/dev/null || printf '0')"
    now="$(date +%s)"
    if [ "$owner_pid" -eq 0 ] && [ "$lock_created" -gt 0 ] && [ $((now - lock_created)) -gt 5 ]; then
      rm -rf "$command_lock_dir" 2>/dev/null || true
      continue
    fi
    if [ "$command_waited" -ge 180 ]; then
      echo "[paperclip-browser] issue browser '$safe_issue' is still busy after 180 seconds" >&2
      return 75
    fi
    sleep 1
    command_waited=$((command_waited + 1))
  done
  printf '%s\n' "$$" > "$command_lock_dir/pid"
  command_lock_held=true
}
release_command_lock() {
  if [ "$command_lock_held" = true ]; then
    rm -rf "$command_lock_dir" 2>/dev/null || true
    command_lock_held=false
  fi
}

lock_held=false
acquire_lock() {
  lock_waited=0
  while ! mkdir "$lock_dir" 2>/dev/null; do
    lock_created="$(stat -c %Y "$lock_dir" 2>/dev/null || printf '0')"
    now="$(date +%s)"
    if [ "$lock_created" -gt 0 ] && [ $((now - lock_created)) -gt 15 ]; then
      rm -rf "$lock_dir" 2>/dev/null || true
      continue
    fi
    if [ "$lock_waited" -ge 10 ]; then
      echo "[paperclip-browser] shared profile '$safe_profile' is busy; retry the managed command instead of creating another session" >&2
      return 75
    fi
    sleep 1
    lock_waited=$((lock_waited + 1))
  done
  printf '%s\n' "$$" > "$lock_dir/pid"
  lock_held=true
}
release_lock() {
  if [ "$lock_held" = true ]; then
    rm -rf "$lock_dir" 2>/dev/null || true
    lock_held=false
  fi
}
cleanup_locks() {
  release_lock
  release_command_lock
}
trap cleanup_locks EXIT HUP INT TERM

save_shared_state() {
  temporary_base="$profile_dir/.agent-browser-state.$$.json"
  rm -f "$temporary_base" "$temporary_base.enc"
  if ! "$REAL_AGENT_BROWSER" state save "$temporary_base" >/dev/null 2>&1; then
    rm -f "$temporary_base" "$temporary_base.enc"
    return 1
  fi
  written_state="$temporary_base"
  if [ -f "$temporary_base.enc" ]; then
    written_state="$temporary_base.enc"
  fi
  if [ ! -f "$written_state" ]; then
    return 1
  fi
  chmod 600 "$written_state" 2>/dev/null || true
  mv -f "$written_state" "$state_path"
}

first="${1:-}"
second="${2:-}"
artifact_root="${PAPERCLIP_HOME:-/paperclip}/browser-artifacts"
safe_scope="$(printf '%s' "${PAPERCLIP_BROWSER_SCOPE_ID:-${PAPERCLIP_RUN_ID:-manual}}" | tr -c 'a-zA-Z0-9._-' '_')"
provider_path="$artifact_root/$safe_scope-provider"
sync_state=true
case "$first:$second" in
  skills:*|session:list)
    sync_state=false
    ;;
esac

if [ "$sync_state" = true ]; then
  acquire_command_lock || exit $?
  mkdir -p "$activity_root"
  touch "$activity_path"
  chmod 600 "$activity_path" 2>/dev/null || true
  if [ -n "${PAPERCLIP_API_URL:-}" ] && [ -n "${PAPERCLIP_API_KEY:-}" ] && [ -n "${PAPERCLIP_RUN_ID:-}" ]; then
    curl -fsS --max-time 3 -X POST \
      -H "Authorization: Bearer $PAPERCLIP_API_KEY" \
      -H "X-Paperclip-Run-Id: $PAPERCLIP_RUN_ID" \
      "$PAPERCLIP_API_URL/api/heartbeat-runs/$PAPERCLIP_RUN_ID/browser-activity" \
      >/dev/null 2>&1 || true
  fi
fi

if [ "$sync_state" = true ]; then
  mkdir -p "$artifact_root"
  printf '%s\n' "agent-browser" > "$provider_path"
  chmod 600 "$provider_path" 2>/dev/null || true
fi

if [ "$sync_state" = true ] && [ -s "$state_path" ]; then
  # Existing issue daemons ignore the launch-only variable and retain their
  # tabs, but some releases still forward it to a daemon that was launched
  # without an encryption key. Only provide it when no live daemon exists.
  daemon_pid_file="${AGENT_BROWSER_SOCKET_DIR:-}/$issue_identity.pid"
  daemon_socket="${AGENT_BROWSER_SOCKET_DIR:-}/$issue_identity.sock"
  daemon_pid="$(cat "$daemon_pid_file" 2>/dev/null || printf '0')"
  case "$daemon_pid" in
    ''|*[!0-9]*) daemon_pid=0 ;;
  esac
  if [ ! -S "$daemon_socket" ] || [ "$daemon_pid" -le 0 ] || ! kill -0 "$daemon_pid" 2>/dev/null; then
    export AGENT_BROWSER_STATE="$state_path"
  fi
fi

if [ "$sync_state" = true ] && [ "$first" = "close" ]; then
  acquire_lock || exit $?
  save_shared_state || true
  release_lock
fi

"$REAL_AGENT_BROWSER" "$@"
status=$?

if [ "$sync_state" = true ] && [ "$first" != "close" ] && [ "$status" -eq 0 ]; then
  acquire_lock || exit $?
  save_shared_state || true
  release_lock
fi

exit "$status"
