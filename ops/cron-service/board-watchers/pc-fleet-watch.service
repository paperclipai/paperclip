[Unit]
Description=Scoped Paperclip host watcher pc-fleet-watch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pc-fleet-watch
Group=pc-fleet-watch
Environment=PYTHONNOUSERSITE=1
Environment=HOME=/var/lib/pc-fleet-watch
Environment=PAPERCLIP_TOKEN_FILE=/var/lib/pc-fleet-watch/.secrets/paperclip.token
Environment=PGSERVICEFILE=/var/lib/pc-fleet-watch/.secrets/pg_service.conf
Environment=PGPASSFILE=/var/lib/pc-fleet-watch/.secrets/pgpass
EnvironmentFile=/etc/paperclip-cron/pc-fleet-watch.env
WorkingDirectory=/opt/paperclip-cron
ExecStart=/usr/bin/python3 /opt/paperclip-cron/fleet.py
StateDirectory=pc-fleet-watch
StateDirectoryMode=0700
UMask=0077
UnsetEnvironment=PYTHONPATH NODE_OPTIONS BASH_ENV
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pc-fleet-watch
PrivateTmp=true
