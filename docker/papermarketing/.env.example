# Do not put real credentials in this example. init-env.mjs creates .env.
PAPERMARKETING_PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_ALLOWED_HOSTNAMES=
# Full git commit for the image and optional remote provider pack.
PAPERCLIP_BUILD_COMMIT=
# Independent, persistent secrets. Use hex characters for POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=
# No host-wide LLM keys: configure a connection per agent through the app.
