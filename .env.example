# Paperclip Docker Compose environment
# Copy this file to .env and replace every change-me value before starting.

# -----------------------------------------------------------------------------
# Authentication
# Generate independent values with: openssl rand -hex 32
# -----------------------------------------------------------------------------
PAPERCLIP_AUTH_SECRET=change-me-paperclip-auth-secret
BETTER_AUTH_SECRET=change-me-better-auth-secret

# -----------------------------------------------------------------------------
# Paperclip deployment
# PAPERCLIP_PORT is published only on 127.0.0.1 by docker-compose.yml.
# -----------------------------------------------------------------------------
PAPERCLIP_PORT=3100
PAPERCLIP_DATA_DIR=./data/docker-paperclip
PAPERCLIP_PUBLIC_URL=https://paperclip.example.com
PAPERCLIP_ALLOWED_HOSTNAMES=paperclip.example.com
BETTER_AUTH_BASE_URL=https://paperclip.example.com
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_AUTH_DISABLE_SIGN_UP=true

# -----------------------------------------------------------------------------
# Container identity and Docker socket access
# Match USER_UID/USER_GID to the owner of PAPERCLIP_DATA_DIR.
# Set DOCKER_GID to: stat -c '%g' /var/run/docker.sock
# -----------------------------------------------------------------------------
USER_UID=1000
USER_GID=1000
DOCKER_GID=992

# -----------------------------------------------------------------------------
# Database
# Leave COMPOSE_PROFILES, POSTGRES_PASSWORD, and DATABASE_URL unset/commented to
# use Paperclip's embedded PostgreSQL. Enable the values below for the separate
# PostgreSQL service. POSTGRES_DATA_DIR can also be an absolute host path.
# URL-encode POSTGRES_PASSWORD before placing it in DATABASE_URL when it contains
# characters that are not safe in a URL.
# -----------------------------------------------------------------------------
COMPOSE_PROFILES=postgres
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgres://paperclip:change-me-postgres-password@postgres:5432/paperclip
POSTGRES_DATA_DIR=postgres-data

# -----------------------------------------------------------------------------
# TLS proxy
# Real certificate bind mounts remain in the ignored docker-compose.override.yml.
# -----------------------------------------------------------------------------
PAPERCLIP_TLS_SERVER_NAME=paperclip.example.com
PAPERCLIP_TLS_CERT_ALT_NAMES=DNS:paperclip.example.com,DNS:localhost,IP:127.0.0.1

# -----------------------------------------------------------------------------
# Optional workspace Git scan limits
# -----------------------------------------------------------------------------
# PAPERCLIP_WORKSPACE_GIT_SCAN_CONCURRENCY=2
# PAPERCLIP_WORKSPACE_GIT_SCAN_QUEUE_CAPACITY=32
# PAPERCLIP_WORKSPACE_GIT_SCAN_TIMEOUT_MS=8000
# PAPERCLIP_WORKSPACE_GIT_SCAN_CACHE_TTL_MS=10000

# Discord webhook for scripts/discord-daily-digest.sh
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
