# Enrichment dispatcher environment variables
# Copy to .env or set in your shell before running:
#   python -m enrichment.dispatcher [--batch-size N]
#
# Required
DATABASE_URL=postgresql://enrichment_dispatcher:<password>@<host>/<dbname>

# Company-scoped dispatcher identity
ENRICHMENT_COMPANY_ID=<company-uuid>

# Control-plane routine management (cost-cap auto-pause)
PAPERCLIP_API_URL=<control-plane-api-url>
PAPERCLIP_API_KEY=<short-lived run JWT — injected automatically during routine execution>
PAPERCLIP_ROUTINE_ID=<routine-id>
ENRICHMENT_ISSUE_ID=<issue-id>

# LiteLLM gateway
LITELLM_BASE_URL=<litellm-base-url>

# Anthropic Opus reviewer (required for reviewer tier)
ANTHROPIC_API_KEY=<secret>

# Tuning (optional — all have safe defaults)
ENRICHMENT_BATCH_SIZE=10
ENRICHMENT_DISPATCHER_CONCURRENCY=1
COST_CAP_LEDGER_PATH=./enrichment_cost_ledger.json

# OpenShell sandbox — non-interactive agent execution paths
# Flip OPENSH_SANDBOX_ENABLED to 1 for a sandboxed deployment; leave 0 for local development.
OPENSH_SANDBOX_ENABLED=1
OPENSH_SANDBOX_TAG=0.0.47
OPENSH_USE_GRPC=1
OPENSH_GRPC_HOST=<openshell-grpc-host>
OPENSH_MACOS_FALLBACK=container
OPENSH_POOL_SIZE=3
# Alert fires (Paperclip comment) when total pool RAM exceeds this threshold
# Baseline: ~42 MiB at pool=3 (measured reference); alert = 5× floor
OPENSH_RAM_ALERT_MIB=200
